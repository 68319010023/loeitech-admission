{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Bash(npm run dev)",
      "Bash(npm run dev:watch)",
      "Bash(npm run build)",
      "Bash(npm run lint)",
      "Bash(npm run format)",
      "Bash(npm run type-check)",
      "Bash(npm install)",
      "Bash(npm install *)",
      "Bash(docker-compose up *)",
      "Bash(docker-compose down)"
    ]
  }
}